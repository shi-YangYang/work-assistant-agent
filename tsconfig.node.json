{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/desktop/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/env.d.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
