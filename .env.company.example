# Copy to .env.company; never commit real credentials.
POSTGRES_DB=paa_company
POSTGRES_USER=paa
# Use URL-safe random letters/digits; keep in sync with DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://paa:replace-with-a-long-random-password@127.0.0.1:5432/paa_company
# Tests require a separate database migrated with the same schema.
DATABASE_TEST_URL=postgresql+psycopg://paa:replace-with-a-long-random-password@127.0.0.1:5432/paa_company_test
PAA_MEDIA_DIR=data/company/media
PAA_WEB_ORIGIN=http://127.0.0.1:5174
PAA_COOKIE_SECURE=false
PAA_FFMPEG=ffmpeg
# Optional CPU voiceprint subprocess. Install with Python 3.12: scripts/company/install-voiceprints.py.
# Defaults to .venv-voiceprints; these overrides require absolute paths.
# PAA_VOICEPRINT_PYTHON=/absolute/path/.venv-voiceprints/bin/python
# PAA_VOICEPRINT_MODEL=/absolute/path/embedding/pytorch_model.bin
# Production: public domain, or fixed public IPv4 with compose.ip.yml; set PAA_WEB_ORIGIN=https://that-host.
# Secure cookies are enforced by Compose. See docs/setup.md for trusted IP certificates and renewal.
PAA_DOMAIN=work.example.com
# Optional deployment company UUID for public DingTalk login. Empty resolves only a single-company database.
# With multiple companies and no selection, the public DingTalk entry is disabled.
PAA_LOGIN_COMPANY_ID=
# Configure new companies in Web: Settings > Model services. Legacy variables can be explicitly imported only by a company present at schema upgrade.
# Optional local private key path; defaults to data/company/model-master.key. Initialize once with node scripts/company/run.mjs model-key.
# PAA_MODEL_KEY_FILE=data/company/model-master.key
# Production: existing host file, readable only by container uid 10001; keep outside repository/image.
PAA_MODEL_KEY_HOST_PATH=/srv/paa-secrets/model-master.key
# Deployment-controlled exact origins for private gateways, empty by default. Never set a wildcard.
PAA_MODEL_ALLOWED_ORIGINS=
# Independent legacy server credentials; no Electron keys are read.
PAA_AGENT_BASE_URL=
PAA_AGENT_API_KEY=
PAA_AGENT_MODEL=qwen3.5-flash-2026-02-23
PAA_AGENT_OPTIONS={"enable_thinking":false}
PAA_ASR_BASE_URL=
PAA_ASR_API_KEY=
PAA_ASR_MODEL=qwen3-asr-flash

# 单个 worker 的并发处理上限（1～8），同一员工仍串行
PAA_WORKER_CONCURRENCY=3
